<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cs351-backend</name>
    <description>CS 351 starter backend</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/example/demo/DemoApplication*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>4.1.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-xml</artifactId>
                        <version>4.0.24</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-coverage-threshold</id>
                        <phase>test</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
import groovy.xml.XmlSlurper

def reportFile = new File(project.build.directory, 'site/jacoco/jacoco.xml')
if (!reportFile.exists()) {
    throw new RuntimeException('Coverage report was not generated. Run mvn test again after fixing the JaCoCo setup.')
}

def report = new XmlSlurper().parse(reportFile)
def instructionCounter = report.counter.find { it.@type.text() == 'INSTRUCTION' }
if (instructionCounter == null) {
    throw new RuntimeException('Coverage data is missing from jacoco.xml.')
}

def missed = instructionCounter.@missed.toBigDecimal()
def covered = instructionCounter.@covered.toBigDecimal()
def total = missed + covered
if (total == 0) {
    throw new RuntimeException("Don't forget it's mandatory to maintain 80% code coverage")
}

def ratio = covered / total
log.info(String.format('Instruction coverage: %.2f%%', ratio * 100))
if (ratio < 0.80) {
    throw new RuntimeException("Don't forget it's mandatory to maintain 80% code coverage")
}
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
